* text=auto eol=lf

# Composer installs this repository (composer.json at the root). Keep the
# Dart and Node SDKs, specs, tests and tooling out of the PHP dist archive.
/.github            export-ignore
/.env.example       export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/dart               export-ignore
/node               export-ignore
/spec               export-ignore
/php/tests          export-ignore
/php/phpunit.xml.dist export-ignore
/php/phpstan.neon   export-ignore
/CONTRIBUTING.md    export-ignore
/composer.lock      export-ignore
/.php-cs-fixer.dist.php export-ignore
