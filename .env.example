# ABA PayWay partner sandbox credentials, used by the integration tests of
# every SDK. Copy to .env (never commit it) and fill in the values ABA gave you.
ABA_PARTNER_API_URL="https://sandbox.payway.com.kh"
ABA_PARTNER_NAME="provided by ABA"
ABA_PARTNER_ID="provided by ABA"
ABA_PARTNER_REFERER_DOMAIN="your whitelisted domain, e.g. https://example.com"
ABA_PARTNER_KEY="provided by ABA"
# base64 of the PEM files, so each fits on one line: base64 -i key.pem
ABA_PARTNER_PRIVATE_KEY="base64 of your partner private key PEM"
ABA_PARTNER_PUBLIC_KEY="base64 of the partner public key PEM"
